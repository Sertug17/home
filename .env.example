# Public client configuration for the later CDP provider integration.
NEXT_PUBLIC_CDP_PROJECT_ID=

# Server-only CDP credentials. Never expose these with a NEXT_PUBLIC_ prefix.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# The current UI preview does not consume these values and remains credential-free.
# Store real local values in apps/web/.env.local (gitignored, permission 0600).
