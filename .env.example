# Public CDP project configuration for email sign-in.
NEXT_PUBLIC_CDP_PROJECT_ID=

# Server-only CDP credentials. Never expose these with a NEXT_PUBLIC_ prefix.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional CDP SQL auth. Default mode is client-api-key and uses only the
# dedicated SQL client key. Set signed-jwt explicitly to use the project key
# above for the fixed CDP SQL endpoint.
CDP_SQL_AUTH_MODE=client-api-key
CDP_SQL_CLIENT_API_KEY=

# Home browsing works without credentials; account sign-in requires these values.
# Store real local values in apps/web/.env.local (gitignored, permission 0600).

# Home disables CDP server SDK telemetry when these are unset. Set either to
# false only as an intentional operator override after reviewing CDP's policy.
DISABLE_CDP_USAGE_TRACKING=true
DISABLE_CDP_ERROR_REPORTING=true
